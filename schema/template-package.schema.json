{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimpeel-tech/apex-templates/schema/template-package.schema.json",
  "title": "APEX Template Package",
  "type": "object",
  "required": ["format_version", "id", "name", "template", "sections"],
  "properties": {
    "format_version": {"const": 1},
    "repo_version": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "output_pattern": {"type": "string"},
    "template": {"$ref": "#/$defs/template"},
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "template": {
      "type": "object",
      "required": ["name", "file"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "settings": {"$ref": "#/$defs/settings"}
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["name", "symbol", "file"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "file": {"type": "string", "minLength": 1},
        "settings": {"$ref": "#/$defs/settings"},
        "functions": {
          "type": "array",
          "items": {"$ref": "#/$defs/function"},
          "default": []
        }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": ["name", "symbol", "file"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "file": {"type": "string", "minLength": 1},
        "settings": {"$ref": "#/$defs/settings"}
      },
      "additionalProperties": false
    }
  }
}
