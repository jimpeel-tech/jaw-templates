{% set linkedin = user.linkedin | default('', true) %}
{% set portfolio = user.portfolio | default('', true) %}

\documentclass[10pt,letterpaper]{article}
\usepackage[letterpaper,margin=0.82in]{geometry}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{ragged2e}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\definecolor{JawBlue}{HTML}{364C60}
\hypersetup{colorlinks=true,urlcolor=JawBlue}

\begin{document}

{\LARGE\bfseries\color{JawBlue} {{ user.full_name | default('Your Name', true) }}}\\[0.08in]
