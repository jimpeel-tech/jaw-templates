{% if linkedin %}\quad \href{ {{ linkedin }} }{LinkedIn}{% endif %}
{% if portfolio %}\quad \href{ {{ portfolio }} }{Portfolio}{% endif %}

\vspace{0.18in}
\hrule
\vspace{0.18in}

{{ system.current_date }}\\[0.12in]

\textbf{ {{ job_ref.title | default('Position', true) }} }\\
{{ job_ref.company | default('Company', true) }}\\[0.18in]

{{ greeting }}

\vspace{0.10in}
