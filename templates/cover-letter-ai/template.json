{
  "format_version": 1,
  "repo_version": "0.1.1",
  "id": "cover-letter-ai",
  "name": "Cover Letter - AI",
  "description": "Job-aware cover letter with deterministic greeting/signoff and AI-generated body paragraphs using the active JAW provider and Generation Context.",
  "output_pattern": "{{ user.full_name }} - Cover Letter.pdf",
  "template": {
    "name": "Cover Letter Template - AI",
    "file": "template.jinja"
  },
  "sections": [
 
    {
      "symbol": "greeting",
      "file": "sections/greeting.jinja",
      "settings": {"content_shape": "paragraphs"},
      "functions": []
    },
    {
      "symbol": "body",
      "file": "sections/body.jinja",
      "settings": {
        "content_shape": "paragraphs"},
      "functions": []
    },
    {
      "symbol": "signoff",
      "file": "sections/signoff.jinja",
      "settings": {
        "content_shape": "paragraphs"},
      "functions": []
    }
  ]
}
